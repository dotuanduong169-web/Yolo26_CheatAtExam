# ── Sao chép file này thành .env rồi chỉnh theo môi trường ──────────────
# cp .env.example .env

# Bắt buộc: chuỗi kết nối PostgreSQL (khớp docker-compose.yml: host port 5433)
DATABASE_URL=postgresql://examcheat:examcheat123@localhost:5433/examcheat

# Bắt buộc đổi khi triển khai thật (production từ chối khóa mặc định)
SECRET_KEY=doi-khoa-bi-mat-nay

# development | production (production bắt buộc HTTPS cho cookie)
ENVIRONMENT=development
DEBUG=False

# Địa chỉ API backend
API_HOST=0.0.0.0
API_PORT=8000

# Danh sách origin frontend được phép CORS, phân tách bằng dấu phẩy.
# Để trống khi chạy local / tunnel: tự động cho phép mọi origin qua regex an toàn.
ALLOWED_ORIGINS=

# Địa chỉ Public HTTPS máy chủ (FastAPI 8000) khi chạy Cloudflare Tunnel hoặc Domain
# Ví dụ: PUBLIC_EXAM_URL=https://exam-demo.trycloudflare.com hoặc https://exam.domain.com
# (Nếu để trống, hệ thống tự lấy IP mạng LAN hoặc bạn có thể nhập trực tiếp trên giao diện Giám thị)
PUBLIC_EXAM_URL=

# ── Mô hình AI ─────────────────────────────────────────────────────────
# Để trống dùng backend/ai_model/weights/best_openvino_model (fallback best.pt)
MODEL_PATH=
MODEL_CONF=0.25
MODEL_IMGSZ=512
MODEL_TRACK=1
MODEL_STRIDE=2
MODEL_KEEP=5

# Để trống dùng backend/ai_model/weights/yolo26n-pose_openvino_model
POSE_MODEL_PATH=
POSE_CONF=0.25
POSE_STRIDE=3
MODEL_BEH_KEEP=5

# ── Lưu dữ liệu và chống spam sự kiện ──────────────────────────────────
SAVE_INTERVAL_SECONDS=10
# Cooldown tính riêng theo từng nhãn (cellphone không chặn Cheat_Paper).
OBJECT_COOLDOWN_SECONDS=15
POSE_COOLDOWN_SECONDS=6
# Hành vi tư thế phải lặp ở số tick liên tiếp này mới lưu (quay_sau bỏ qua).
POSE_CONFIRM_TICKS=2
# Một nhãn mất bao nhiêu tick thì kết thúc "đợt" và cho phép cảnh báo lại.
ALERT_CLEAR_TICKS=2

# ── Vắng mặt / camera bị che (chỉ camera trước) ─────────────────────────
# Không thấy người liên tục quá ngưỡng này (giây) thì báo vang_mat.
ABSENT_SECONDS=6
# Ảnh tối/phẳng/mất chi tiết liên tục quá ngưỡng này thì báo vang_mat
# (bắt trường hợp lấy tay che camera).
OBSTRUCTED_SECONDS=4
ABSENT_DARK_MEAN=22
ABSENT_FLAT_STD=8
ABSENT_FLAT_LAPLACIAN=15

# ── Pipeline snapshot 2 bước (raw -> normalized/thumbnail/annotated) ────
# Chu kỳ lưu snapshot nền cho mỗi luồng camera (giây, tối thiểu 5)
SNAPSHOT_INTERVAL_SECONDS=30
# Cạnh rộng tối đa của ảnh normalized / thumbnail (pixel)
SNAPSHOT_MAX_WIDTH=1280
SNAPSHOT_THUMB_WIDTH=480
# Chất lượng JPEG khi ghi ảnh đã chuẩn hoá (50-95)
SNAPSHOT_JPEG_QUALITY=85

# ── Nhật ký tick 2,5 giây (tbl_candidate_timeline) ─────────────────────
# Bật ghi mọi tick có cảnh báo + tick đổi trạng thái + heartbeat khi sạch.
TIMELINE_ENABLED=1
# Chu kỳ heartbeat khi không có cảnh báo (giây, tối thiểu 5)
TIMELINE_HEARTBEAT_SECONDS=30
# Ảnh thumbnail nhẹ cho mỗi tick: cạnh rộng tối đa (px) và chất lượng JPEG
TIMELINE_IMAGE_MAX_WIDTH=480
TIMELINE_JPEG_QUALITY=72
# Thumbnail live cho lưới giám thị (giữ trong RAM, không ghi đĩa)
LIVE_THUMB_MAX_WIDTH=400
LIVE_THUMB_JPEG_QUALITY=68

# ── Tinh chỉnh luật hành vi (tùy chọn, xem backend/ai_model/behavior.py) ─
# BEH_FACE_VIS_MIN=0.25
# BEH_FACE_HIDDEN_MAX=0.12
# BEH_SHO_VIS_MIN=0.35
# BEH_TURN_RATIO=0.32
# BEH_BEND_RATIO=0.05
# BEH_MIN_SHOULDER_WIDTH=40
# BEH_MIN_EYE_DIST=12
# BEH_EYE_YAW_RATIO=0.45
