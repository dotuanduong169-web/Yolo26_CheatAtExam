# ── Sao chép file này thành .env rồi chỉnh theo môi trường ──────────────
# cp .env.example .env

# Bắt buộc: chuỗi kết nối PostgreSQL (khớp docker-compose.yml)
DATABASE_URL=postgresql://examcheat:examcheat123@localhost:5432/examcheat

# Bắt buộc đổi khi triển khai thật (production từ chối khóa mặc định)
SECRET_KEY=doi-khoa-bi-mat-nay

# development | production (production bắt buộc HTTPS cho cookie)
ENVIRONMENT=development
DEBUG=False

# Địa chỉ API backend
API_HOST=0.0.0.0
API_PORT=8000

# Danh sách origin frontend được phép CORS, phân tách bằng dấu phẩy.
# Để trống khi chạy local: mặc định cho phép cổng 8501/8502.
ALLOWED_ORIGINS=

# ── Mô hình AI ─────────────────────────────────────────────────────────
# Để trống dùng backend/ai_model/weights/best_openvino_model (fallback best.pt)
MODEL_PATH=
MODEL_CONF=0.25
MODEL_IMGSZ=512
MODEL_TRACK=1
MODEL_STRIDE=2
MODEL_KEEP=5

# Để trống dùng backend/ai_model/weights/yolo26n-pose_openvino_model
POSE_MODEL_PATH=
POSE_CONF=0.25
POSE_STRIDE=3
MODEL_BEH_KEEP=5

# ── Lưu dữ liệu và chống spam sự kiện ──────────────────────────────────
SAVE_INTERVAL_SECONDS=10
OBJECT_COOLDOWN_SECONDS=15
POSE_COOLDOWN_SECONDS=6

# ── Tinh chỉnh luật hành vi (tùy chọn, xem backend/ai_model/behavior.py) ─
# BEH_FACE_VIS_MIN=0.25
# BEH_SHO_VIS_MIN=0.35
# BEH_TURN_RATIO=0.32
